#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC        &kp Q  &kp W  &kp E  &kp R               &kp T                                                 &kp Y  &kp U                     &kp I      &kp O    &kp P                  &kp BACKSPACE
&mt LCTRL TAB  &kp A  &kp S  &kp D  &kp F               &kp G                                                 &kp H  &kp J                     &kp K      &kp L    &kp MINUS              &kp ENTER
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V               &kp B  &kp LEFT_ALT            &kp RIGHT_ALT          &kp N  &kp M                     &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH  &mo 2
                                    &mt LEFT_GUI LANG2  &mo 1  &mt LEFT_SHIFT SPACE    &mt RIGHT_SHIFT SPACE  &mo 1  &mt RIGHT_GUI LANGUAGE_1
            >;
        };

        layer_1 {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                            &kp N7        &kp N8         &kp N9        &kp EQUAL  &kp BACKSLASH      &kp GRAVE
&trans     &kp DOLLAR       &kp PERCENT   &kp CARET  &kp LEFT_BRACKET      &kp RIGHT_BRACKET                                &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp PLUS   &kp COLON          &kp SEMI
&trans     &kp AMPERSAND    &kp ASTERISK  &kp PIPE   &kp LEFT_BRACE        &kp RIGHT_BRACE        &mo 3     &studio_unlock  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp N0     &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE
                                                     &kp LEFT_GUI          &trans                 &trans    &trans          &trans        &kp RIGHT_GUI
            >;
        };

        layer_2 {
            bindings = <
&bt BT_SEL 0  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                     &trans  &trans  &trans    &kp UP     &trans        &trans
&bt BT_SEL 1  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                    &trans  &trans  &kp LEFT  &kp RIGHT  &trans        &trans
&bt BT_SEL 2  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans    &trans  &trans  &trans  &trans    &kp DOWN   &kp QUESTION  &trans
                                         &trans   &trans   &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                          &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };
    };
};
